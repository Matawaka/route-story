{
  "name": "route-story",
  "version": "1.1.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run test:e2e",
    "validate:video": "node scripts/validate-video.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:acceptance": "node scripts/acceptance/release.mjs"
  },
  "dependencies": {
    "mediabunny": "1.61.3"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@xmldom/xmldom": "0.9.12",
    "ffmpeg-static": "5.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
